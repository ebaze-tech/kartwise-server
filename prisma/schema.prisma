generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  BUSINESS_OWNER
  BUYER
  ADMIN
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  SENT
  FAILED
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum BusinessOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
}

// ============================================================
// USER
// ============================================================

model User {
  id                String  @id @default(cuid())
  username          String
  firstName         String
  lastName          String
  email             String  @unique
  password          String
  emailVerified     Boolean @default(false)
  profilePictureUrl String?
  permanentAddress  String?
  role              Role

  refreshToken String?
  otp          String?
  otpExpiresAt DateTime?

  // Relations
  resetTokens             PasswordResetToken[]
  emailTokens             EmailUpdateToken[]
  sessions                Session[]
  sentEmails              SentEmail[]
  emailVerificationTokens EmailVerificationToken[]

  businesses Business[]
  orders     Order[]
  cart       Cart?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
  @@index([email])
  @@map("users")
}

// ============================================================
// AUTHENTICATION / TOKENS
// ============================================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model EmailUpdateToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  newEmail  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("email_update_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

model Session {
  id           String   @id @default(cuid())
  refreshToken String
  expiresAt    DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ============================================================
// EMAIL
// ============================================================

model SentEmail {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventType String
  recipient String
  subject   String
  from      String
  body      String

  status EmailStatus @default(PENDING)

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  lastAttemptAt DateTime?
  sentAt        DateTime?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([recipient])
  @@map("sent_emails")
}

// ============================================================
// OUTBOX
// ============================================================

model Outbox {
  id          String       @id @default(cuid())
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([topic])
  @@map("outbox")
}

// ============================================================
// BUSINESS
// ============================================================

model Business {
  id             String  @id @default(cuid())
  name           String
  description    String
  emailAddress   String  @unique
  phoneNumber    String
  address        String
  bannerImageUrl String?
  isActive       Boolean @default(false)

  // Relations
  products            Product[]
  businessBankDetails BusinessBankDetails[]
  orders              BusinessOrder[]

  categoryName String
  category     BusinessCategory @relation(fields: [categoryName], references: [name], onDelete: Cascade)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([categoryName])
  @@index([name])
  @@index([isActive])
  @@map("business")
}

model BusinessBankDetails {
  id            String @id @default(cuid())
  accountNumber String
  bankName      String
  accountName   String

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@map("business_bank_details")
}

model BusinessCategory {
  id          String @id @default(cuid())
  name        String @unique
  description String

  businesses Business[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("business_categories")
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id          String  @id @default(cuid())
  name        String
  description String
  price       Decimal @db.Decimal(10, 2)
  isAvailable Boolean @default(true)
  stockCount  Int     @default(0)

  // Relations
  images         ProductImage[]
  productReviews ProductReview[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  productCategoryName String
  productCategory     ProductCategory @relation(fields: [productCategoryName], references: name)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([name])
  @@index([isAvailable])
  @@index([productCategoryName])
  @@map("products")
}

model ProductCategory {
  id          String @id @default(cuid())
  name        String @unique
  description String

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("product_categories")
}

model ProductImage {
  id       String @id @default(cuid())
  url      String
  publicId String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_images")
}

model ProductReview {
  id      String  @id @default(cuid())
  rating  Int
  comment String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_reviews")
}

// ============================================================
// CART
// ============================================================

model Cart {
  id String @id @default(cuid())

  items CartItem[]

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id       String @id @default(cuid())
  quantity Int

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id String @id @default(cuid())

  status OrderStatus @default(PENDING)

  // Financial snapshot
  subTotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)

  // Snapshot of where the order should be delivered
  shippingAddress String

  // Relations
  businessOrders BusinessOrder[]
  payments       Payment[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// ============================================================
// BUSINESS ORDER
// ============================================================

model BusinessOrder {
  id String @id @default(cuid())

  status BusinessOrderStatus @default(PENDING)

  // Financial snapshot for this particular business
  subTotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)

  // Relations
  items OrderItem[]

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One business can only occur once inside one order
  @@unique([orderId, businessId])
  @@index([orderId])
  @@index([businessId])
  @@index([status])
  @@map("business_orders")
}

// ============================================================
// ORDER ITEM
// ============================================================

model OrderItem {
  id String @id @default(cuid())

  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  businessOrderId String
  businessOrder   BusinessOrder @relation(fields: [businessOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessOrderId])
  @@index([productId])
  @@map("order_items")
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id String @id @default(cuid())

  provider  PaymentProvider
  reference String          @unique
  amount    Decimal         @db.Decimal(10, 2)
  status    PaymentStatus   @default(PENDING)
  paidAt    DateTime?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([provider])
  @@map("payments")
}
